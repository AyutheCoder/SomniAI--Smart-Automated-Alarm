<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets adb set and inspect native alarms for the device
     checks (ANDROID.md, "Checking alarms on a device"). Guarded by DUMP, which
     adb's shell holds and ordinary apps cannot get. Not in release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".alarms.DebugAlarmReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.somniai.alarm.debug.SCHEDULE" />
                <action android:name="app.somniai.alarm.debug.CANCEL" />
                <action android:name="app.somniai.alarm.debug.DISMISS" />
                <action android:name="app.somniai.alarm.debug.LIST" />
                <action android:name="app.somniai.alarm.debug.SYNC" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

# Copy this file to ".env.local" and fill in real values.
# IMPORTANT: never prefix secrets with NEXT_PUBLIC_ (that exposes them to the browser).

# MongoDB connection string (local or Atlas). Required for persistence.
MONGO_DB_URI="mongodb://localhost:27017/somniai"

# --- Authentication (NextAuth) ---
# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Public base URL of the app (used for OAuth callbacks).
NEXTAUTH_URL="http://localhost:3000"

# Optional Google OAuth. Leave blank to run with email/password-only.
# When set, also set NEXT_PUBLIC_GOOGLE_ENABLED=true to show the Google button.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# NEXT_PUBLIC_GOOGLE_ENABLED="false"

# Optional: URL of the Python "AI Brain" FastAPI service (added in a later phase).
# AI_BRAIN_URL="http://localhost:8000"
# Copy this file to ".env.local" and fill in real values.
# IMPORTANT: never prefix secrets with NEXT_PUBLIC_ (that exposes them to the browser).

# MongoDB connection string (local or Atlas). Required for persistence.
MONGO_DB_URI="mongodb://localhost:27017/somniai"

# --- Authentication (NextAuth) ---
# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Public base URL of the app (used for OAuth callbacks).
NEXTAUTH_URL="http://localhost:3000"

# Optional Google OAuth. Leave blank to run with email/password-only.
# When set, also set NEXT_PUBLIC_GOOGLE_ENABLED=true to show the Google button.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# NEXT_PUBLIC_GOOGLE_ENABLED="false"

# Optional: URL of the Python "AI Brain" FastAPI service (added in a later phase).
# AI_BRAIN_URL="http://localhost:8000"

# Development only: let the /simulator page's made-up data feed predictions so
# you can see its effect. Never set in production, which ignores it anyway.
# SOMNIAI_SIMULATED_INPUTS="allow"

# --- Wake buddy (BUDDY.md) ---
# The scheduler's key for /api/cron/buddy-alerts. Without it, no alerts are sent.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=
# Firebase Cloud Messaging, from a service-account key. Fill these with
# node scripts/firebase-env.mjs <downloaded key.json>, which never prints the key.
# Without them, alerts are recorded as "push isn't set up on the server".
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

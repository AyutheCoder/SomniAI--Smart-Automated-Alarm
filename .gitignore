# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# python ai-brain
__pycache__/
ai-brain/.venv/
ai-brain/venv/
*.pyc

# Trained model artifacts (~25 MB of binaries). predict.py retrains them from
# the dataset on first boot if they are missing, so they don't belong in git.
ai-brain/models/*.joblib

# Third-party datasets. Large, and redistribution terms vary by source - each is
# fetched from its own repository by scripts in ai-brain/data/. See
# docs/dataset-decision.md for provenance and licences.
ai-brain/data/external/

# logs
dev.log
*.log

# Paper figures. Regenerated by evaluation/run_study.py, so not committed.
/figures/

# Real author block. Kept out of git so no name reaches the anonymised
# artifact mirror during double-blind review. Recreate for camera-ready.
paper/authors.local.tex

# Identity list for scripts/check-anonymity.mjs. Never commit.
.anonymity-terms.local

# Playwright output
/test-results/
/playwright-report/
/blob-report/

# Firebase (wake-buddy push, BUDDY.md): the app config names the project, and
# the service-account key is a secret. Neither is ever committed.
google-services.json
*-firebase-adminsdk-*.json
*service-account*.json

# Local MongoDB data for npm run dev:phone (scripts/dev-phone.mjs).
/.data/
